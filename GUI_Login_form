import tkinter as tk
from tkinter import messagebox


def login():
    username = username_entry.get()
    password = password_entry.get()

    if username == "Admin" and password == "12345":
        messagebox.showinfo(
            "LOGIN SUCCESSFULLY!",
            "Welcome Admin!"
        )
    elif username == "Student" and password == "12345":
         messagebox.showinfo(
            "LOGIN SUCCESSFULLY!",
            "Welcome Student!"
            )
    else:
        messagebox.showerror(
            "LOGIN FAILED!",
            "Invalid Username and Password!"
        )


#Main Window 
root = tk.Tk()
root.title("Login Form")
root.geometry("400x350")
root.configure(bg="#0E0248")
root.resizable(False, False)

#Title 
title_label = tk.Label(
    root,
    text="USER LOGIN",
    font=("Arial", 20, "bold"),
    bg="#11243d",
    fg="white"
)
title_label.pack(pady=(25, 15))

#Username 
username_label = tk.Label(
    root,
    text="Username",
    font=("Arial", 11),
    bg="#1e2a3a",
    fg="#cbd5e1"
)
username_label.pack(pady=5)

username_entry = tk.Entry(
    root,
    font=("Arial", 12),
    width=25,
    bg="#f8fafc",
    fg="black",
    relief="flat"
)
username_entry.pack(pady=5, ipady=4)

#Password
password_label = tk.Label(
    root,
    text="Password",
    font=("Arial", 11),
    bg="#1e2a3a",
    fg="#cbd5e1"
)
password_label.pack(pady=5)

password_entry = tk.Entry(
    root,
    font=("Arial", 12),
    width=25,
    show="*",
    bg="#f8fafc",
    fg="black",
    relief="flat"
)
password_entry.pack(pady=5, ipady=4)

#Login Button
login_button = tk.Button(
    root,
    text="LOG IN",
    font=("Arial", 12, "bold"),
    bg="#2563eb",
    fg="white",
    activebackground="#1d4ed8",
    activeforeground="white",
    width=10,
    relief="flat",
    cursor="hand2",
    command=login
)
login_button.pack(pady=25)

# Press Enter to log in
root.bind("<Return>", lambda event: login())

# ---------- Run ----------
root.mainloop()
